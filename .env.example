# Qloo hackathon key (server-side only). Only valid on the hackathon base URL.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Anthropic API key for the agent (server-side only).
ANTHROPIC_API_KEY=

# Optional: a Redis REST store (Upstash, e.g. through the Vercel Marketplace).
# Shares the Qloo response cache across server instances and keeps it across
# deploys, and backs the live-analysis limits.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: limits on live analyses (examples are never limited).
LIVE_PER_IP_PER_HOUR=8
LIVE_PER_DAY=60
